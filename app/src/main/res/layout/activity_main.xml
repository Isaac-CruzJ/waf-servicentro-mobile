<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- Título principal utilizando la llave del strings.xml -->
    <TextView
        android:id="@+id/tvTitleHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_home"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnAddVehicle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="32dp"/>

    <!-- Botón para añadir vehículo -->
    <Button
        android:id="@+id/btnAddVehicle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_add_vehicle"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitleHome"
        app:layout_constraintBottom_toTopOf="@id/btnBookService"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp"/>

    <!-- Botón para reservar servicio -->
    <Button
        android:id="@+id/btnBookService"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_book_service"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnAddVehicle"
        app:layout_constraintBottom_toTopOf="@id/btnViewServices"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp"/>

    <!-- Botón para ver la lista de servicios -->
    <Button
        android:id="@+id/btnViewServices"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_view_services"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnBookService"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>