<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    tools:context=".ServiceBookingActivity">

    <!-- Título de la sección de reservas -->
    <TextView
        android:id="@+id/tvBookingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_book_service"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="24dp"/>

    <!-- Selector o campo para el servicio -->
    <EditText
        android:id="@+id/etServiceName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Service Type (e.g. Oil Change)"
        android:inputType="text"
        android:minHeight="48dp"
        app:layout_constraintTop_toBottomOf="@id/tvBookingTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:autofillHints="name" />

    <!-- Etiqueta para la fecha -->
    <TextView
        android:id="@+id/lblBookingDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Booking Date:"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/etServiceName"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp"/>

    <!-- TextView que mostrará la fecha seleccionada -->
    <TextView
        android:id="@+id/tvBookingDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="DD/MM/YYYY"
        android:textSize="16sp"
        android:padding="12dp"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/lblBookingDate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnSelectDate"
        android:layout_marginTop="8dp" />

    <!-- Botón con icono de calendario (idéntico al estilo TaskManager) -->
    <ImageButton
        android:id="@+id/btnSelectDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@android:drawable/ic_menu_my_calendar"
        app:layout_constraintTop_toTopOf="@id/tvBookingDate"
        app:layout_constraintBottom_toBottomOf="@id/tvBookingDate"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="Select Date"
        android:padding="12dp" />

    <!-- Botón para confirmar la reserva -->
    <Button
        android:id="@+id/btnConfirmBooking"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_save"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvBookingDate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>

    <!-- Botón para cancelar -->
    <Button
        android:id="@+id/btnCancelBooking"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_cancel"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnConfirmBooking"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>